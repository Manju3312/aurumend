# AURUMEND - Environment Configuration

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurumend"

# Multi-Tenant & CLI Key Signing
JWT_SECRET="aurumend-super-secret-jwt-signing-key-32-chars-min"

# GitHub App — required for live repo scans and real pull requests.
# Create the app at https://github.com/settings/apps
# Callback URL: http://localhost:3000/api/github/callback
# Webhook URL:  http://localhost:3000/api/github/webhook
# Permissions: Contents (read), Pull requests (read & write), Metadata (read)
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
NEXT_PUBLIC_GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
# Paste the .pem contents on one line, with real newlines written as \n
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_SLUG="aurumend-bot"
NEXT_PUBLIC_GITHUB_APP_SLUG="aurumend-bot"

# Anthropic Claude — optional. Without it, migration manifests use the built-in Stripe/OpenAI rules.
ANTHROPIC_API_KEY=""

# E2B sandbox — optional. Verification logs are simulated until this key is set.
E2B_API_KEY=""

# Trigger.dev — optional background jobs. The Next.js API runs the same work inline without it.
TRIGGER_API_KEY=""
TRIGGER_API_URL="https://api.trigger.dev"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

