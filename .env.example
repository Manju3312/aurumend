# AURUMEND - Environment Configuration

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurumend"

# Multi-Tenant & CLI Key Signing
JWT_SECRET="aurumend-super-secret-jwt-signing-key-32-chars-min"

# GitHub App Integration
GITHUB_APP_ID="123456"
GITHUB_APP_CLIENT_ID="Iv1.xxxxxxxxx"
GITHUB_APP_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_SLUG="aurumend-bot"
NEXT_PUBLIC_GITHUB_APP_SLUG="aurumend-bot"

# Anthropic Claude API (Sonnet 3.5 / 3.7)
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxx"

# Sandbox Verification (E2B)
E2B_API_KEY="e2b_xxxxxxxxxxxxxxxx"

# Trigger.dev Background Orchestrator
TRIGGER_API_KEY="tr_prod_xxxxxxxxxxxxxxxx"
TRIGGER_API_URL="https://api.trigger.dev"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

